{
  "name": "svelte-pivottable",
  "version": "0.4.2",
  "description": "A Svelte-based pivot table with grouping",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjagielka/svelte-pivottable.git"
  },
  "keywords": [
    "svelte",
    "sevltekit",
    "pivottable"
  ],
  "author": {
    "name": "Jakub Jagielka",
    "email": "jjagielka@gmail.com"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./PivotTable": {
      "types": "./dist/PivotTable.svelte.d.ts",
      "svelte": "./dist/PivotTable.svelte"
    },
    "./PivotTableUI": {
      "types": "./dist/PivotTableUI.svelte.d.ts",
      "svelte": "./dist/PivotTableUI.svelte"
    },
    "./TableRenderers": {
      "types": "./dist/TableRenderers.d.ts",
      "default": "./dist/TableRenderers.js"
    },
    "./PlotlyRenderers": {
      "types": "./dist/PlotlyRenderers.d.ts",
      "default": "./dist/PlotlyRenderers.js"
    },
    "./Utilities": {
      "types": "./dist/Utilities.d.ts",
      "default": "./dist/Utilities.js"
    },
    "./formatters": {
      "types": "./dist/formatters.d.ts",
      "default": "./dist/formatters.js"
    }
  },
  "bugs": {
    "url": "https://github.com/jjagielka/svelte-pivottable/issues"
  },
  "homepage": "https://github.com/jjagielka/svelte-pivottable#readme",
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/plotly.js": "^3.0.10",
    "@types/sortablejs": "^1.15.9",
    "svelte-check": "^4.4.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "peerDependencies": {
    "svelte": "^5.33.19"
  },
  "type": "module",
  "dependencies": {
    "sortablejs": "^1.15.7"
  }
}
